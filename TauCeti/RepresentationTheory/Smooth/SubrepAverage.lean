module

public import TauCeti.RepresentationTheory.Smooth.UOperator

/-!
# Stability of subrepresentations under smooth averaging and `U`-operators

For a smooth representation `ρ : Representation A G V` and a subrepresentation `W`, averaging a
vector of `W` over a compact subgroup `C` (with `HasUnitProOrder A C`) stays inside `W`, and
hence every `U`-operator `ρ.uOperator C hC t` preserves `W`. In particular, the cyclic
subrepresentation `ρ.cyclicSubrep y` generated by a vector `y : V` is preserved by all smooth
averages and `U`-operators.

* `Representation.cyclicSubrep`: the subrepresentation spanned by `{ρ g y | g : G}`.
* `Representation.self_mem_cyclicSubrep`: `y ∈ ρ.cyclicSubrep y`.
* `Representation.smoothAverage_mem_subrepresentation`: for a subrepresentation `W` and
  `v ∈ W`, `smoothAverage (ρ.comp C.subtype) hC v ∈ W`.
* `Representation.uOperator_mem_subrepresentation`: for a subrepresentation `W`, `t : G`, and
  `v ∈ W`, `ρ.uOperator C hC t v ∈ W`.
* `Representation.uOperator_mem_cyclicSubrep`: `ρ.uOperator C hC t v ∈ ρ.cyclicSubrep y` for
  `v ∈ ρ.cyclicSubrep y`.

## References

* W. Casselman, *Introduction to admissible representations of p-adic groups: `GL_n`*, notes.

## Provenance

* Adapted from grh-lean (https://github.com/lsernau/grh-lean, Apache 2.0, Copyright 2026 Anthropic,
  PBC), file `src/Lib/LocalGL/Iwahori/ParahoricStructure.lean` (`New.cyclicSpan`,
  `New.self_mem_cyclicSpan`, `New.apply_mem_cyclicSpan`, `New.compactMean_mem_cyclicSpan`).
-/

public section

namespace Representation

section Cyclic

variable {A G V : Type*} [CommSemiring A] [Monoid G] [AddCommMonoid V] [Module A V]
  (ρ : Representation A G V)

/-- The cyclic subrepresentation spanned over `A` by the orbit `{ρ g y | g : G}` of `y : V`. -/
def cyclicSubrep (y : V) : Subrepresentation ρ where
  toSubmodule := Submodule.span A (Set.range fun g : G ↦ ρ g y)
  apply_mem_toSubmodule g v hv := by
    refine Submodule.span_induction (p := fun v _ ↦ ρ g v ∈ Submodule.span A _) ?_ ?_ ?_ ?_ hv
    · rintro _ ⟨a, rfl⟩
      exact Submodule.subset_span ⟨g * a, by simp [map_mul]⟩
    · simp
    · intro x y _ _ hx hy
      simpa [map_add] using Submodule.add_mem _ hx hy
    · intro c x _ hx
      simpa [map_smul] using Submodule.smul_mem _ c hx

/-- Every vector belongs to its own cyclic subrepresentation. -/
theorem self_mem_cyclicSubrep (y : V) : y ∈ ρ.cyclicSubrep y :=
  Submodule.subset_span ⟨1, by simp⟩

end Cyclic

section Smooth

variable {A G V : Type*} [CommRing A] [Group G] [TopologicalSpace G] [SeparatelyContinuousMul G]
  [AddCommGroup V] [Module A V] (ρ : Representation A G V) [IsSmooth ρ]
  (C : Subgroup G) [CompactSpace C] (hC : TauCeti.HasUnitProOrder A C)

/-- Averaging a vector in a subrepresentation `W` over a compact subgroup `C` remains in `W`. -/
theorem smoothAverage_mem_subrepresentation (W : Subrepresentation ρ) {v : V} (hv : v ∈ W) :
    smoothAverage (ρ.comp C.subtype) hC v ∈ W := by
  have h0 : W.toSubmodule.mkQ (smoothAverage (ρ.comp C.subtype) hC v) = 0 := by
    rw [map_smoothAverage_of_forall_apply_eq (ρ.comp C.subtype) hC W.toSubmodule.mkQ
      (fun k ↦ by
        simp only [Submodule.mkQ_apply, Submodule.Quotient.eq]
        exact W.toSubmodule.sub_mem (W.apply_mem_toSubmodule k.val hv) hv)]
    exact (Submodule.Quotient.mk_eq_zero W.toSubmodule).mpr hv
  exact (Submodule.Quotient.mk_eq_zero W.toSubmodule).mp h0

/-- Every `U`-operator `ρ.uOperator C hC t` preserves every subrepresentation `W`. -/
theorem uOperator_mem_subrepresentation (W : Subrepresentation ρ) (t : G) {v : V} (hv : v ∈ W) :
    ρ.uOperator C hC t v ∈ W := by
  rw [uOperator_apply]
  exact ρ.smoothAverage_mem_subrepresentation C hC W (W.apply_mem_toSubmodule t hv)

/-- Every `U`-operator `ρ.uOperator C hC t` preserves the cyclic subrepresentation
`ρ.cyclicSubrep y`. -/
theorem uOperator_mem_cyclicSubrep (t : G) {y v : V} (hv : v ∈ ρ.cyclicSubrep y) :
    ρ.uOperator C hC t v ∈ ρ.cyclicSubrep y :=
  ρ.uOperator_mem_subrepresentation C hC (ρ.cyclicSubrep y) t hv

end Smooth

end Representation
